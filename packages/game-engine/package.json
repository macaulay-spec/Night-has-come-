{
  "name": "@night-has-come/game-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Server-authoritative game engine for NIGHT HAS COME",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./state": "./src/state/index.ts",
    "./phases": "./src/phases/index.ts",
    "./roles": "./src/roles/index.ts",
    "./commands": "./src/commands/index.ts",
    "./resolution": "./src/resolution/index.ts",
    "./voting": "./src/voting/index.ts",
    "./ruleset": "./src/ruleset/index.ts",
    "./replay": "./src/replay/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@night-has-come/contracts": "*",
    "@night-has-come/config": "*"
  },
  "devDependencies": {
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
