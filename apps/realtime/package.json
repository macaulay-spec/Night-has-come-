{
  "name": "@night-has-come/realtime",
  "version": "0.1.0",
  "private": true,
  "description": "NIGHT HAS COME — Realtime WebSocket server (Socket.IO)",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
